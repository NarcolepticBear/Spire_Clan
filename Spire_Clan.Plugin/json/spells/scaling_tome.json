{
  "$schema": "https://github.com/Monster-Train-2-Modding-Group/Trainworks-Reloaded/releases/latest/download/schema.json",
  "cards": [
    {
      "id": "ScalingTome",
      "cost": 1,
      "card_type": "spell",
      "names": {
        "english": "Scaling Tome",
        "chinese": "成长之书"
      },
      "descriptions": {
        "english": "Give a friendly unit Resolve: +10 [attack] and +10 [health].",
        "chinese": "使一个友方单位获得战斗结束时触发的能力：+10 攻击和 +10 生命。"
      },
      "rarity": "rare",
      "targets_room": true,
      "targetless": false,
      "class": "@ClassBasic",
      "card_art": "@BasicCommonSpellCardArt",
      "effects": [
        "@ScalingTomeApplyUpgrade"
      ],
      "pools": [
        "MegaPool"
      ],
      "traits": [
        "@Consume"
      ],
      "lore_tooltips": [
        {
          "english": "The page grows heavier with every battle.",
          "chinese": "每一场战斗都会让这页书变得更重。"
        }
      ]
    }
  ],
  "upgrades": [
    {
      "id": "ScalingTomeUpgrade",
      "trigger_upgrades": [
        "@ScalingTomePostCombat"
      ]
    },
    {
      "id": "ScalingTomePostCombatStats",
      "bonus_damage": 10,
      "bonus_hp": 10
    }
  ],
  "character_triggers": [
    {
      "id": "ScalingTomePostCombat",
      "trigger": "post_combat",
      "descriptions": {
        "english": "Gain +[effect0.upgrade.bonusdamage][attack] and +[effect0.upgrade.bonushp][health].",
        "chinese": "获得 +[effect0.upgrade.bonusdamage][attack] 和 +[effect0.upgrade.bonushp][health]。"
      },
      "effects": [
        "@ScalingTomePostCombatGainStats"
      ]
    }
  ],
  "effects": [
    {
      "id": "ScalingTomeApplyUpgrade",
      "name": "CardEffectAddCardUpgradeToUnits",
      "target_mode": "drop_target_character",
      "target_team": "monsters",
      "param_upgrade": "@ScalingTomeUpgrade",
      "param_int_3": 0
    },
    {
      "id": "ScalingTomePostCombatGainStats",
      "name": "CardEffectAddCardUpgradeToUnits",
      "target_mode": "self",
      "target_team": "monsters",
      "param_upgrade": "@ScalingTomePostCombatStats",
      "param_int_3": 0
    }
  ]
}
